---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EditorApp from '../../components/EditorApp';
import { localizePath, useTranslations, type SiteLang } from '../../i18n/utils';
import { absoluteUrl, getSiteOrigin } from '../../lib/site';
import { editors } from '../../data/editors';
import RpgMakerMvGuide from '../RpgMakerMvGuide.astro';
import RpgMakerMzGuide from '../RpgMakerMzGuide.astro';

interface EngineData {
  slug: string;
  name: string;
  fileType: string;
  title: string;
  description: string;
  keywords: string;
  features: string[];
  instructions: string[];
}

interface Props {
  engine: EngineData;
  lang?: SiteLang;
}

const { engine, lang = 'en' } = Astro.props;
const t = useTranslations(lang);
const siteOrigin = getSiteOrigin(Astro.site);
const absUrl = (path: string) => absoluteUrl(path, siteOrigin);
const homeHref = localizePath('/', lang);
const editorHref = localizePath(`/editor/${engine.slug}`, lang);
const homeUrl = absUrl(homeHref);
const editorUrl = absUrl(editorHref);
---

<BaseLayout title={engine.title} description={engine.description} keywords={engine.keywords}>
  <section class="container mx-auto px-4 py-8">
    <div class="mx-auto max-w-6xl">
      <nav class="mb-8 flex text-sm text-gray-500" aria-label="Breadcrumb">
        <ol class="inline-flex items-center space-x-1 md:space-x-3">
          <li class="inline-flex items-center">
            <a href={homeHref} class="transition-colors hover:text-gray-900 dark:hover:text-white">
              {t('nav.home')}
            </a>
          </li>
          <li>
            <div class="flex items-center">
              <svg class="mx-1 h-3 w-3 text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"></path>
              </svg>
              <span class="ml-1 font-medium text-gray-700 dark:text-gray-300">{engine.name}</span>
            </div>
          </li>
        </ol>
      </nav>

      <div class="mb-10 text-center">
        <h1 class="mb-4 text-3xl font-bold text-gray-900 dark:text-white sm:text-4xl">
          {engine.name} Save Editor
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400">
          Choose a compatible
          <code class="rounded bg-gray-100 px-2 py-1 text-sm dark:bg-gray-800 dark:text-gray-300">{engine.fileType}</code>
          file.
        </p>
      </div>

      <div id="editor-workspace" class="min-h-[400px]">
        <EditorApp
          client:only="react"
          acceptedFileTypes={engine.fileType}
          editorSlug={engine.slug}
        />
        <noscript>
          <p class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-center text-sm text-amber-800">
            JavaScript is required to run the local browser {engine.name} Save Editor for {engine.fileType} files.
          </p>
        </noscript>
      </div>

      <div class="prose prose-blue mt-16 max-w-none dark:prose-invert">
        <h2>How to use the {engine.name} Save Editor</h2>
        <ol>
          {
            engine.instructions.map((step) => (
              <li>
                <Fragment set:html={step.replace(/`([^`]+)`/g, '<code>$1</code>')} />
              </li>
            ))
          }
        </ol>

        {engine.slug === 'rpg-maker-mv' && (
          <figure class="my-8 not-prose overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-700 dark:bg-gray-800">
            <img
              src="/images/savefiletool-editor.png" width="1280" height="960"
              alt="RPG Maker MV Save Editor showing verified browser-side gold editing"
              class="w-full h-auto block"
              loading="lazy"
              decoding="async"
            />
            <figcaption class="border-t border-gray-100 bg-gray-50 px-4 py-3 text-center text-sm text-gray-600 dark:border-gray-700 dark:bg-gray-800/90 dark:text-gray-300">
              Example browser session in SaveFileTool: inspect detected MV values locally and download the edited .rpgsave file together with an original backup.
            </figcaption>
          </figure>
        )}

        <h2>Published {engine.name} Save Editor features</h2>
        <ul>
          {engine.features.map((feature) => <li>{feature}</li>)}
        </ul>
        {engine.slug === 'rpg-maker-mv' && (
          <RpgMakerMvGuide />
        )}
        {engine.slug === 'rpg-maker-mz' && (
          <RpgMakerMzGuide />
        )}

        <div class="not-prose mt-12">
          <h2 class="mb-4 text-2xl font-bold text-gray-900 dark:text-white">Related RPG Maker Tools &amp; Guides</h2>
          <div class="grid gap-4 sm:grid-cols-3">
            {editors.filter(other => other.slug !== engine.slug).map(other => (
              <a
                href={localizePath(`/editor/${other.slug}`, lang)}
                class="block rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-primary-400 hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
              >
                <div class="text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">{other.fileType}</div>
                <div class="mt-1 font-bold text-gray-900 dark:text-white">{other.name} Save Editor</div>
                <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Switch to the dedicated {other.name} editor if your game uses {other.fileType} slots.</p>
              </a>
            ))}
            <a
              href={localizePath('/faq', lang)}
              class="block rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-primary-400 hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
            >
              <div class="text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">Troubleshooting</div>
              <div class="mt-1 font-bold text-gray-900 dark:text-white">Save Editor FAQ</div>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Answers on save folder paths, browser-hosted games, custom plugins, and backup recovery.</p>
            </a>
            <a
              href={localizePath('/support', lang)}
              class="block rounded-xl border border-gray-200 bg-white p-5 shadow-sm transition hover:border-primary-400 hover:shadow-md dark:border-gray-700 dark:bg-gray-800"
            >
              <div class="text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">Help &amp; Scope</div>
              <div class="mt-1 font-bold text-gray-900 dark:text-white">Support &amp; Format Requests</div>
              <p class="mt-2 text-sm text-gray-600 dark:text-gray-300">Report a parse issue or check our verification policy for additional RPG Maker formats.</p>
            </a>
          </div>
        </div>

        <div class="not-prose mt-10 rounded-xl border border-blue-100 bg-blue-50 p-6 dark:border-blue-900/30 dark:bg-blue-950/20">
          <h3 class="mb-2 text-lg font-bold text-blue-900 dark:text-blue-400">Backup-first editing &amp; open-source transparency</h3>
          <p class="mb-4 text-blue-700 dark:text-blue-300">
            Keep the original save file until the edited copy loads correctly in game. SaveFileTool is{' '}
            <a href="https://github.com/bikai9289/savefiletool" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-900">
              open source on GitHub
            </a>
            , built for{' '}
            <a href="https://www.rpgmakerweb.com/" target="_blank" rel="noopener noreferrer" class="underline hover:text-blue-900">
              RPG Maker
            </a>{' '}
            save workflows.
          </p>
          <a href={homeHref} class="font-medium text-blue-600 hover:underline dark:text-blue-400">
            Back to RPG Maker Save Editor home &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: `${engine.name} Save Editor`,
      description: engine.description,
      applicationCategory: 'UtilitiesApplication',
      operatingSystem: 'Web Browser',
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      featureList: engine.features,
      url: editorUrl,
      author: {
        '@type': 'Organization',
        name: 'SaveFileTool',
        url: absUrl('/'),
      },
    })}
  />
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: homeUrl,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: `${engine.name} Save Editor`,
          item: editorUrl,
        },
      ],
    })}
  />
</BaseLayout>
